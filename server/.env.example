PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://username:password@your-neon-host.aws.neon.tech/neondb?sslmode=require
DB_SCHEMA=erp
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
